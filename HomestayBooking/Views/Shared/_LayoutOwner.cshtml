@{
    Layout = null;
    var username = Session["Account"] ?? "Owner";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Chủ Homestay - @ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/Content/admin-sidebar.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.10.24/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <button class="toggle-btn" id="toggleBtn">☰</button>
        <div class="logo">
            <img src="https://via.placeholder.com/40" alt="Logo" />
        </div>
        <nav class="sidebar__nav">
            <ul>
                <li class="active">
                    <a href="@Url.Action("Index", "Home", new { area = "Owner" })"><i data-feather="grid"></i><span>Trang chủ</span></a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Bookings", new { area = "Owner" })"><i data-feather="calendar"></i><span>Đơn đặt phòng</span></a>
                </li>
                <li>
                    <a href="https://localhost:44349/Owner/Homestays"><i data-feather="home"></i><span>Quản lý Homestay</span></a>
                </li>
                <li>
                    <a href="@Url.Action("Login", "Accounts", new { area = "" })"><i data-feather="log-out"></i><span>Đăng xuất</span></a>
                </li>
            </ul>
        </nav>
        <div class="sidebar__footer">
            <img src="https://via.placeholder.com/150x100" alt="Image" />
            <p>Chủ Homestay</p>
            <div class="user">
                <img src="https://via.placeholder.com/32" alt="User" />
                <div class="user-info">
                    <strong>@username</strong>
                    <small><a href="@Url.Action("Login", "Accounts", new { area = "" })">Đăng xuất</a></small>
                </div>
            </div>
        </div>
    </aside>
    <div style="flex:1; padding: 2rem;">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.24/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.24/js/dataTables.bootstrap5.min.js"></script>
    <script>
        feather.replace();
        // Toggle sidebar
        document.getElementById('toggleBtn').onclick = function () {
            document.getElementById('sidebar').classList.toggle('collapsed');
        };
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html> 