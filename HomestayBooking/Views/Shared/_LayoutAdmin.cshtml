@{
    Layout = null;
    var username = Session["Account"] ?? "Admin";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Quản trị - @ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/Content/admin-sidebar.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <script src="https://unpkg.com/feather-icons"></script>
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <button class="toggle-btn" id="toggleBtn">☰</button>
        <div class="logo">
            <img src="https://via.placeholder.com/40" alt="Logo" />
        </div>
        <nav class="sidebar__nav">
            <ul>
                <li class="active">
                    <a href="@Url.Action("Index", "Home", new { area = "Admin" })"><i data-feather="grid"></i><span>Trang chủ</span></a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Accounts", new { area = "" })"><i data-feather="users"></i><span>Quản lý tài khoản</span></a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Homestays", new { area = "Admin" })"><i data-feather="home"></i><span>Quản lý homestay</span></a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Bookings", new { area = "" })"><i data-feather="calendar"></i><span>Đơn đặt phòng</span></a>
                </li>
            </ul>
        </nav>
        <div class="sidebar__footer">
            <img src="https://via.placeholder.com/150x100" alt="Image" />
            <p></p>
            <div class="user">
                <img src="https://via.placeholder.com/32" alt="User" />
                <div class="user-info">
                    <strong>@username</strong>
                    <small><a href="@Url.Action("Logout", "Accounts", new { area = "" })">Đăng xuất</a></small>
                </div>
            </div>
        </div>
    </aside>
    <div style="flex:1; padding: 2rem;">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        feather.replace();
        // Toggle sidebar
        document.getElementById('toggleBtn').onclick = function () {
            document.getElementById('sidebar').classList.toggle('collapsed');
        };
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
