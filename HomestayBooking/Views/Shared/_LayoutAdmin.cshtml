@{
    Layout = null;
    var username = Session["Account"] ?? "Admin";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Quản trị - @ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">
        <div class="row bg-dark text-white p-3">
            <div class="col-md-10">
                <h4>Hệ thống quản trị HomestayBooking</h4>
            </div>
            <div class="col-md-2 text-end">
                Xin chào, <strong>@username</strong> |
                <a href="/Account/Logout" class="text-white">Đăng xuất</a>
            </div>
        </div>

        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 bg-light p-3" style="min-height: 100vh;">
                <h5>Quản lý</h5>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="/Accounts">Tài khoản</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Homestays">Homestay</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Bookings">Đơn đặt phòng</a>
                    </li>
                    <!-- Thêm mục khác nếu cần -->
                </ul>
            </div>

            <!-- Main content -->
            <div class="col-md-10 p-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
