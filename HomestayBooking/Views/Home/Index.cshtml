@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<div class="hero-section bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">
                    <i class="fas fa-home me-3"></i>
                    Khám phá Homestay tuyệt vời
                </h1>
                <p class="lead mb-4">
                    Trải nghiệm những ngôi nhà độc đáo, ấm cúng và đầy tiện nghi.
                    Đặt phòng dễ dàng với giá cả hợp lý.
                </p>
                @if (!User.Identity.IsAuthenticated)
                {
                    <div class="d-flex gap-3">
                        <a href="@Url.Action("Login", "Accounts")" class="btn btn-light btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Đăng nhập
                        </a>
                        <a href="@Url.Action("Create", "Accounts")" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-user-plus me-2"></i>
                            Đăng ký
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert alert-light" role="alert">
                        <i class="fas fa-user-check me-2"></i>
                        Chào mừng bạn, <strong>@ViewBag.Username</strong>!
                    </div>
                    <div class="d-flex gap-3">
                        <a href="@Url.Action("Rooms", "Home")" class="btn btn-light btn-lg">
                            <i class="fas fa-bed me-2"></i>
                            Xem phòng
                        </a>
                    </div>
                }
            </div>
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80"
                    alt="Homestay" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</div>

<!-- Search Section -->
<div class="search-section py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow">
                    <div class="card-body p-4">
                        <h3 class="text-center mb-4">
                            <i class="fas fa-search me-2"></i>
                            Tìm homestay phù hợp
                        </h3>
                        <form>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Địa điểm</label>
                                    <input type="text" class="form-control" placeholder="Nhập địa điểm...">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Ngày đến</label>
                                    <input type="date" class="form-control">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Ngày đi</label>
                                    <input type="date" class="form-control">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Khách</label>
                                    <select class="form-select">
                                        <option>1</option>
                                        <option>2</option>
                                        <option>3</option>
                                        <option>4+</option>
                                    </select>
                                </div>
                            </div>
                            <div class="text-center mt-4">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-search me-2"></i>
                                    Tìm kiếm
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Featured Rooms Section -->
@if (ViewBag.FeaturedRooms != null && ((List<HomestayBooking.Models.Rooms>)ViewBag.FeaturedRooms).Any())
{
<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h2 class="text-center mb-5">
                <i class="fas fa-star me-2"></i>
                    Phòng nổi bật
            </h2>
        </div>
    </div>
    <div class="row g-4">
            @foreach (var room in (List<HomestayBooking.Models.Rooms>)ViewBag.FeaturedRooms)
            {
                var priceText = (room.PricePerNight != null) ? room.PricePerNight.Value.ToString("N0") : "Liên hệ";
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm">
                        @if (room.RoomImages != null && room.RoomImages.Any() && !string.IsNullOrEmpty(room.RoomImages.First().ImageURL))
                        {
                            <img src="@Url.Content(room.RoomImages.First().ImageURL)"
                                 class="card-img-top"
                                 alt="@room.Name"
                                 style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center"
                                 style="height: 200px; background-color: #f8f9fa;">
                                <div class="text-center text-muted">
                                    <i class="fas fa-image" style="font-size: 32px; margin-bottom: 5px;"></i>
                                    <br><small>Không có ảnh</small>
                                </div>
                            </div>
                        }
                <div class="card-body">
                            <h5 class="card-title">@room.Name</h5>
                    <p class="card-text text-muted">
                                <i class="fas fa-home me-1"></i>
                                @room.Homestay.Name
                    </p>
                    <div class="d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-bold">@priceText VNĐ/đêm</span>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                            <a href="@Url.Action("RoomDetail", "Home", new { id = room.RoomID })" class="btn btn-outline-primary w-100">
                        <i class="fas fa-eye me-2"></i>
                        Xem chi tiết
                    </a>
                </div>
            </div>
        </div>
            }
                        </div>
        <div class="row mt-4">
            <div class="col-12 text-center">
                <a href="@Url.Action("Rooms", "Home")" class="btn btn-primary btn-lg">
                    <i class="fas fa-list me-2"></i>
                    Xem tất cả phòng
                </a>
                    </div>
                </div>
                </div>
}

<!-- Featured Homestays -->
@if (ViewBag.Homestays != null && ((List<HomestayBooking.Models.Homestay>)ViewBag.Homestays).Any())
{
    <div class="container py-5">
        <div class="row">
            <div class="col-12">
                <h2 class="text-center mb-5">
                    <i class="fas fa-home me-2"></i>
                    Danh sách Homestay nổi bật
                </h2>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var homestay in (List<HomestayBooking.Models.Homestay>)ViewBag.Homestays)
            {
                var firstRoomWithImg = homestay.Rooms != null ? homestay.Rooms.FirstOrDefault(r => r.RoomImages.Any(img => !string.IsNullOrEmpty(img.ImageURL))) : null;
                var firstImg = (firstRoomWithImg != null && firstRoomWithImg.RoomImages.Any(img => !string.IsNullOrEmpty(img.ImageURL))) ? firstRoomWithImg.RoomImages.First(img => !string.IsNullOrEmpty(img.ImageURL)).ImageURL : null;
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(firstImg))
                        {
                            <img src="@Url.Content(firstImg)"
                                 class="card-img-top"
                                 alt="@homestay.Name"
                                 style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center"
                                 style="height: 200px; background-color: #f8f9fa;">
                                <div class="text-center text-muted">
                                    <i class="fas fa-image" style="font-size: 32px; margin-bottom: 5px;"></i>
                                    <br><small>Không có ảnh</small>
                                </div>
                            </div>
                        }
                <div class="card-body">
                            <h5 class="card-title">@homestay.Name</h5>
                    <p class="card-text text-muted">
                        <i class="fas fa-map-marker-alt me-1"></i>
                                @homestay.Address
                            </p>
                </div>
                <div class="card-footer bg-transparent">
                            <a href="@Url.Action("HomestayDetail", "Home", new { id = homestay.HomestayID })" class="btn btn-outline-primary w-100">
                        <i class="fas fa-eye me-2"></i>
                        Xem chi tiết
                    </a>
                </div>
            </div>
                </div>
            }
        </div>
    </div>
}

<!-- Features Section -->
<div class="bg-light py-5">
    <div class="container">
        <div class="row text-center">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="feature-item">
                    <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                    <h5>An toàn & Bảo mật</h5>
                    <p class="text-muted">Thanh toán an toàn, thông tin được bảo mật</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="feature-item">
                    <i class="fas fa-clock fa-3x text-primary mb-3"></i>
                    <h5>Hỗ trợ 24/7</h5>
                    <p class="text-muted">Đội ngũ hỗ trợ luôn sẵn sàng giúp đỡ</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="feature-item">
                    <i class="fas fa-medal fa-3x text-primary mb-3"></i>
                    <h5>Chất lượng cao</h5>
                    <p class="text-muted">Homestay được kiểm định chất lượng</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="feature-item">
                    <i class="fas fa-percent fa-3x text-primary mb-3"></i>
                    <h5>Giá tốt nhất</h5>
                    <p class="text-muted">Cam kết giá tốt nhất thị trường</p>
                </div>
            </div>
        </div>
    </div>
</div>