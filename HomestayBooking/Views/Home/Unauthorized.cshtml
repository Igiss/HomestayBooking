@{
    ViewBag.Title = "Không có quyền truy cập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-6 text-center">
            <div class="error-page">
                <div class="error-code">
                    <i class="fas fa-exclamation-triangle text-warning" style="font-size: 5rem;"></i>
                </div>
                <h1 class="text-danger">403</h1>
                <h2>Không có quyền truy cập</h2>
                <p class="text-muted">
                    Bạn không có quyền truy cập vào trang này.
                    Vui lòng liên hệ quản trị viên nếu bạn nghĩ đây là lỗi.
                </p>
                <div class="mt-4">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary me-2">
                        <i class="fas fa-home me-2"></i>
                        Về trang chủ
                    </a>
                    <a href="@Url.Action("Index", "Login")" class="btn btn-outline-secondary">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        Đăng nhập lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .error-page {
        padding: 2rem;
    }

    .error-code {
        margin-bottom: 1rem;
    }

    .error-page h1 {
        font-size: 4rem;
        font-weight: bold;
        margin-bottom: 1rem;
    }

    .error-page h2 {
        font-size: 2rem;
        margin-bottom: 1rem;
    }
</style>