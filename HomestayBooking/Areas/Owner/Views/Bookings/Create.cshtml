@model HomestayBooking.Models.Bookings

@{
    Layout = "~/Views/Shared/_LayoutOwner.cshtml";
}

<div class="container-fluid">
    <h2 class="mb-4">Tạo đơn đặt phòng mới</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        
        <div class="card">
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.UserID, "Khách hàng", htmlAttributes: new { @class = "form-label" })
                            @Html.DropDownList("UserID", null, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.UserID, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.RoomID, "Phòng", htmlAttributes: new { @class = "form-label" })
                            @Html.DropDownList("RoomID", null, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.RoomID, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.CheckInDate, "Ngày check-in", htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.CheckInDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                            @Html.ValidationMessageFor(model => model.CheckInDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.CheckOutDate, "Ngày check-out", htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.CheckOutDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                            @Html.ValidationMessageFor(model => model.CheckOutDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.Status, "Trạng thái", htmlAttributes: new { @class = "form-label" })
                            @Html.DropDownListFor(model => model.Status, new SelectList(new[]
                            {
                                new SelectListItem { Text = "Chờ duyệt", Value = "pending" },
                                new SelectListItem { Text = "Đã xác nhận", Value = "confirmed" },
                                new SelectListItem { Text = "Đã hủy", Value = "cancelled" }
                            }, "Value", "Text"), new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>
                        Tạo đơn đặt phòng
                    </button>
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Đảm bảo ngày check-out không nhỏ hơn ngày check-in
            $('#CheckInDate').change(function() {
                var checkInDate = $(this).val();
                $('#CheckOutDate').attr('min', checkInDate);
            });

            $('#CheckOutDate').change(function() {
                var checkOutDate = $(this).val();
                var checkInDate = $('#CheckInDate').val();
                
                if (checkOutDate < checkInDate) {
                    alert('Ngày check-out không thể nhỏ hơn ngày check-in!');
                    $(this).val(checkInDate);
                }
            });
        });
    </script>
} 