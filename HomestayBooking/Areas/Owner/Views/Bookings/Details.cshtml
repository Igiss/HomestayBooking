@model HomestayBooking.Models.Bookings
@{
    Layout = "~/Views/Shared/_LayoutOwner.cshtml";
}

<div class="container-fluid">
    <h2 class="mb-4">Chi tiết đơn đặt phòng</h2>
    
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.CheckInDate)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.CheckInDate)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.CheckOutDate)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.CheckOutDate)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Status)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Status)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.CreatedAt)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.CreatedAt)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Account.UserName)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Account.UserName)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Rooms.Name)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Rooms.Name)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Payments.PaymentMethod)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Payments.PaymentMethod)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Reviews.Comment)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Reviews.Comment)
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("Edit", "Edit", new { id = Model.BookingID }, new { @class = "btn btn-warning" }) |
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
    </div>
</div> 