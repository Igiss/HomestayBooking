@model HomestayBooking.Models.Rooms
@{
    ViewBag.Title = "Thêm phòng mới";
    Layout = "~/Views/Shared/_LayoutOwner.cshtml";
    int homestayId = ViewBag.HomestayID ?? 0;
    string homestayName = ViewBag.HomestayName ?? "";
}
<h2>Thêm phòng mới - @homestayName</h2>
@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.HomestayID, new { Value = homestayId })
    <div class="form-horizontal">
        <div class="form-group">
            @Html.LabelFor(m => m.Type, "Loại phòng", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <select name="Type" id="Type" class="form-control" onchange="updateRoomName()">
                    <option value="">-- Chọn loại phòng --</option>
                    @for (int i = 1; i <= 10; i++)
                    {
                        <option value="@i">Loại @i</option>
                    }
                </select>
                @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Name, "Tên phòng", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @readonly = "readonly", id = "RoomName" })
                <small class="form-text text-muted">Tên phòng sẽ tự động được tạo dựa trên loại phòng.</small>
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.PricePerNight, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.PricePerNight, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01", min = "0" } })
                @Html.ValidationMessageFor(model => model.PricePerNight, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Available, "Trạng thái", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.CheckBox("Available", Model.Available ?? false) Còn phòng
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Ảnh phòng</label>
            <div class="col-md-10">
                <input type="file" name="images" multiple accept="image/*" class="form-control" />
                <small class="form-text text-muted">Chọn một hoặc nhiều ảnh cho phòng.</small>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Tạo mới" class="btn btn-primary" />
                @Html.ActionLink("Quay lại danh sách", "Index", new { homestayId = homestayId }, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
}

<script>
function updateRoomName() {
    var typeSelect = document.getElementById('Type');
    var roomNameInput = document.getElementById('RoomName');
    var selectedType = typeSelect.value;
    
    if (selectedType) {
        var roomName = '';
        switch (parseInt(selectedType)) {
            case 1:
                roomName = 'Phòng đơn';
                break;
            case 2:
                roomName = 'Phòng đôi';
                break;
            case 3:
            case 4:
            case 5:
                roomName = 'Family Room ' + selectedType + ' người';
                break;
            default:
                roomName = 'Phòng loại ' + selectedType;
                break;
        }
        roomNameInput.value = roomName;
    } else {
        roomNameInput.value = '';
    }
}
</script> 