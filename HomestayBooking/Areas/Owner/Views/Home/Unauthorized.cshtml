@{
    ViewBag.Title = "Không có quyền truy cập";
    Layout = "~/Views/Shared/_LayoutOwner.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Không có quyền truy cập
                    </h4>
                </div>
                <div class="card-body text-center">
                    <i class="fas fa-lock fa-3x text-danger mb-3"></i>
                    <h5 class="card-title">Truy cập bị từ chối</h5>
                    <p class="card-text">
                        Bạn không có quyền truy cập vào trang này. 
                        Vui lòng liên hệ quản trị viên nếu bạn cần quyền truy cập.
                    </p>
                    <div class="mt-4">
                        <a href="@Url.Action("Index", "Home", new { area = "Owner" })" class="btn btn-primary me-2">
                            <i class="fas fa-home me-1"></i>
                            Về trang chủ
                        </a>
                        <a href="@Url.Action("Login", "Accounts")" class="btn btn-secondary">
                            <i class="fas fa-sign-in-alt me-1"></i>
                            Đăng nhập lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 