@model HomestayBooking.Models.Homestay
@{
    ViewBag.Title = "Chi tiết Homestay";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var db = new HomestayBooking.Models.HomestayBookingEntities();
    var images = db.RoomImages.Where(img => img.RoomID == Model.HomestayID).ToList();
}

<h2>Chi tiết Homestay</h2>

<div>
    <h4>Thông tin Homestay</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>ID</dt>
        <dd>@Model.HomestayID</dd>

        <dt>Chủ homestay</dt>
        <dd>@(Model.Account != null ? Model.Account.UserName : "N/A")</dd>

        <dt>Tên homestay</dt>
        <dd>@Model.Name</dd>

        <dt>Địa chỉ</dt>
        <dd>@Model.Address</dd>

        <dt>Mô tả</dt>
        <dd>@(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả" : Model.Description)</dd>

        <dt>Trạng thái</dt>
        <dd>
            <span class="badge @(Model.Status == "active" ? "bg-success" : Model.Status == "inactive" ? "bg-danger" : "bg-warning")">
                @Model.Status
            </span>
        </dd>

        <dt>Ngày tạo</dt>
        <dd>@(Model.CreatedAt != null ? Model.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</dd>
    </dl>
</div>

@if (images.Any())
{
    <h4>Ảnh Homestay</h4>
    <div>
        <img src="@Url.Content(images[0].ImageURL)" class="img-thumbnail" style="max-width:320px;max-height:200px;object-fit:cover;cursor:pointer;" data-bs-toggle="modal" data-bs-target="#galleryModal" />
    </div>
    <!-- Modal Gallery -->
    <div class="modal fade" id="galleryModal" tabindex="-1" aria-labelledby="galleryModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="galleryModalLabel">Thư viện ảnh Homestay</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="row">
              @foreach (var img in images)
              {
                  <div class="col-md-4 mb-3">
                      <img src="@Url.Content(img.ImageURL)" class="img-fluid img-thumbnail" style="max-height:200px;object-fit:cover;" />
                  </div>
              }
            </div>
          </div>
        </div>
      </div>
    </div>
}

<div class="mt-3">
    @Html.ActionLink("Sửa", "Edit", new { id = Model.HomestayID }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Quản lý phòng", "Index", "Rooms", new { area = "Admin", homestayId = Model.HomestayID }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
} 