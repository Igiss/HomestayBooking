@{
    ViewBag.Title = "Trang quản trị";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-2"><i data-feather="grid"></i> Dashboard quản trị</h2>
            <p class="text-muted">Chào mừng bạn, <b>@ViewBag.Username</b>!</p>
        </div>
    </div>
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i data-feather="home" class="mb-2" style="width:32px;height:32px;"></i>
                    <div class="h4">@ViewBag.TotalHomestay</div>
                    <div class="text-muted">Homestay</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i data-feather="layers" class="mb-2" style="width:32px;height:32px;"></i>
                    <div class="h4">@ViewBag.TotalRoom</div>
                    <div class="text-muted">Phòng</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i data-feather="users" class="mb-2" style="width:32px;height:32px;"></i>
                    <div class="h4">@ViewBag.TotalAccount</div>
                    <div class="text-muted">Tài khoản</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i data-feather="calendar" class="mb-2" style="width:32px;height:32px;"></i>
                    <div class="h4">@ViewBag.TotalBooking</div>
                    <div class="text-muted">Đơn đặt phòng</div>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i data-feather="clock" class="mb-2" style="width:28px;height:28px;"></i>
                    <div class="h5">@ViewBag.BookingPending</div>
                    <div class="text-warning">Đơn chờ duyệt</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i data-feather="check-circle" class="mb-2" style="width:28px;height:28px;"></i>
                    <div class="h5">@ViewBag.BookingConfirmed</div>
                    <div class="text-success">Đơn đã xác nhận</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i data-feather="x-circle" class="mb-2" style="width:28px;height:28px;"></i>
                    <div class="h5">@ViewBag.BookingCancelled</div>
                    <div class="text-danger">Đơn đã hủy</div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>feather.replace();</script>
}